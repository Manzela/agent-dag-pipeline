# ══════════════════════════════════════════════════════════════
# Agent DAG Pipeline — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# The pipeline works with zero config using mock LLM.

# ── LLM Provider ──
# Options: mock (default), openai, google
PIPELINE_LLM_PROVIDER=mock
PIPELINE_LLM_MODEL=

# ── API Keys (provider-specific) ──
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google GenAI: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Pipeline Settings ──
PIPELINE_MIN_SEARCH_VOLUME=10
PIPELINE_OUTPUT_DIR=./output

# ── Observability (optional) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
